# Local development only. Generate unique values; never reuse staging or production secrets.
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-url-encoded-password@postgres:5432/containermgmt_pg
JWT_SECRET_KEY=replace-with-random-jwt-secret
MEDIA_SIGNING_KEY=replace-with-separate-random-media-secret
CMA_CGM_WEBHOOK_SECRET=replace-with-random-carrier-webhook-secret
RUSTFS_ACCESS_KEY=replace-with-local-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-local-rustfs-secret-key
MEILI_MASTER_KEY=replace-with-local-meilisearch-key
# Blank keeps all new local stock execution disabled. Use synthetic isolated data
# only. No automatic enrollment/epoch adoption or disconnected failover is implied.
# Optional JSON: mode="local-development", claims=[{org_id,branch_id,node_key,epoch}].
# Every claim must match a separately provisioned persisted node and active epoch.
FREIGHTLENS_LOCAL_STOCK_RUNTIME_JSON=
